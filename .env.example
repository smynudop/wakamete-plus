# Docker Compose development settings
MONGO_PORT=27017
MONGO_DATABASE=wakamete
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=development-root-password
MONGO_APP_USERNAME=wakamete
MONGO_APP_PASSWORD=development-password

# Use this URI from applications running on the host.
MONGODB_URI=mongodb://wakamete:development-password@localhost:27017/wakamete?authSource=wakamete

# Optional for deployments that do not include the pnpm workspace file.
# Must be an absolute path, for example: /opt/wakamete-plus/frontend/dist
# FRONTEND_DIST_PATH=
